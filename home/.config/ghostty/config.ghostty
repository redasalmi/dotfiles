# Font
font-family = JetBrains Mono
font-size = 12

# Cursor
cursor-style = block
cursor-style-blink = true

# Window
window-padding-x = 8
window-padding-y = 8
maximize = true

# Scrolling
scrollback-limit = 10000

# Performance
window-vsync = true

# Theme (example: dark)
theme = GitHub Dark

shell-integration = fish
app-notifications = no-clipboard-copy
